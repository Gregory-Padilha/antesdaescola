# ==============================================================================
# ANTES DA ESCOLA™ - Variáveis de Ambiente (Configuração Segura)
# ==============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais no servidor.
# NUNCA comite o arquivo .env.local ou credenciais reais no Git.

# Porta do Servidor (Padrão: 3000)
PORT=3000
NODE_ENV=production

# Credenciais do Administrador (Configuradas exclusivamente no servidor)
ADMIN_LOGIN=<CONFIGURAR_NO_SERVIDOR>
ADMIN_PASSWORD_HASH=$2a$12$KcoYrPMfproHGQpbC6yTZ.6zjFFxAHevyezH1l0NTwQixfr7wtAFO

# Segredo criptográfico forte para assinatura de sessões (mínimo 32 caracteres aleatórios)
SESSION_SECRET=<SEGREDO_ALEATORIO_FORTE>

# Token secreto do Webhook da Kiwify (Opcional para validação de assinatura)
KIWIFY_WEBHOOK_TOKEN=<TOKEN_WEBHOOK_KIWIFY>
